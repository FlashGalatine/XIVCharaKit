{
  "name": "xivcharakit-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12.0 <23 || >=24"
  },
  "scripts": {
    "dev": "pnpm --filter xivcharakit build && pnpm --filter @xivcharakit/demo dev",
    "preview": "pnpm --filter @xivcharakit/demo preview",
    "preview:cloudflare": "pnpm --filter @xivcharakit/demo preview:cloudflare",
    "test:demo:cloudflare": "pnpm --filter @xivcharakit/demo exec playwright test --config playwright.cloudflare.config.ts",
    "deploy:demo": "pnpm test:demo:cloudflare && pnpm test:package && wrangler deploy --config apps/demo/wrangler.jsonc --autoconfig=false",
    "test": "pnpm run test:tooling && pnpm -r test",
    "test:tooling": "vitest run --config test/vitest.config.ts",
    "build": "pnpm -r build",
    "type-check": "tsc --noEmit -p tsconfig.json && pnpm -r type-check",
    "lint": "biome check .",
    "benchmark": "tsx scripts/benchmark-reader.ts",
    "test:package": "pnpm build && pnpm --dir packages/chara pack --pack-destination ../../.superpowers/package-smoke && tsx scripts/test-package.ts",
    "verify-fixtures": "tsx scripts/verify-fixtures.ts",
    "verify-palettes": "tsx scripts/verify-palettes.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  }
}
