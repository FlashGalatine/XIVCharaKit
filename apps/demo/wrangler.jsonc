{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xivcharakit-demo",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
